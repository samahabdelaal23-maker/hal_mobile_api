<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="hal_mobile_api.HalGoogleMapPicker">

        <div class="hal_google_map_picker">

            <div class="hal_map_header">

                <div>

                    <strong>
                        Google Maps Work Location
                    </strong>

                    <div class="text-muted">
                        Click the exact company location on the map.
                        The blue circle represents the allowed attendance radius.
                    </div>

                </div>

            </div>

            <div class="hal_google_map_container"
                 t-ref="mapContainer">
            </div>

        </div>

    </t>

</templates>
