<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_employee_form_hal_mobile" model="ir.ui.view">
        <field name="name">hr.employee.form.hal.mobile</field>
        <field name="model">hr.employee</field>

        <field name="inherit_id" ref="hr.view_employee_form"/>

        <field name="arch" type="xml">

            <xpath expr="//field[@name='pin']" position="after">

                <separator string="HAL Mobile Application"/>

                <field name="mobile_app_access"/>

                <field name="mobile_app_password"
                       password="True"
                       placeholder="Set mobile app password"/>

                <field name="mobile_app_password_hash"
                       invisible="1"/>

            </xpath>

        </field>
    </record>

</odoo>
